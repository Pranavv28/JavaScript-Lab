                            <label for="mobile">Mobile</label>
                            <span id="mobileIndicator" class="field-indicator">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>10 digits</span>
                            </span>
                        </div>
                        <div class="input-wrapper">
                            <input type="text" id="mobile" placeholder="10-digit number" maxlength="10">
                            <div class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect>
                                    <path d="M12 18h.01"></path>
                                </svg>
                            </div>
                        </div>
                        <div id="mobileError" class="error-message">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <span>Must be 10 digits.</span>
                        </div>
                    </div>

                    <!-- Age -->
                    <div class="form-group">
                        <div class="label-row">
                            <label for="age">Age</label>
                            <span id="ageIndicator" class="field-indicator">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>Eligible</span>
                            </span>
                        </div>
                        <div class="input-wrapper">
                            <input type="number" id="age" placeholder="Min 16" min="1" max="120">
                            <div class="input-icon">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                        </div>
                        <div id="ageError" class="error-message">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            <span>16+ required.</span>
                        </div>
                    </div>
                </div>

                <!-- 5. Membership Plan Selector (INR ₹ / Rs.) -->
                <div class="form-group">
                    <div class="label-row">
                        <label for="planSelect">Membership Plan</label>
                        <span id="planIndicator" class="field-indicator">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Selected</span>
                        </span>
                    </div>

                    <!-- Hidden native select for standard accessibility & events -->
                    <select id="planSelect" style="display: none;">
                        <option value="">Select a plan</option>
                        <option value="basic">Basic (1 Month) - ₹1,499</option>
                        <option value="pro">Pro (6 Months) - ₹6,999</option>
                        <option value="elite">Elite (1 Year) - ₹11,999</option>
                    </select>

                    <!-- Interactive Plan Cards with INR ₹ -->
                    <div class="plan-cards">
                        <div class="plan-card" data-plan="basic" tabindex="0">
                            <span class="plan-name">Basic</span>
                            <span class="plan-duration">1 Month</span>
                            <span class="plan-price">₹1,499</span>
                        </div>
                        <div class="plan-card" data-plan="pro" tabindex="0">
                            <span class="badge">Popular</span>
                            <span class="plan-name">Pro</span>
                            <span class="plan-duration">6 Months</span>
                            <span class="plan-price">₹6,999</span>
                        </div>
                        <div class="plan-card" data-plan="elite" tabindex="0">
                            <span class="badge">VIP</span>
                            <span class="plan-name">Elite</span>
                            <span class="plan-duration">1 Year</span>
                            <span class="plan-price">₹11,999</span>
                        </div>
                    </div>

                    <div id="planError" class="error-message">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span>Please select a membership plan.</span>
                    </div>
                </div>

                <!-- Actions -->
                <div class="actions">
                    <button type="submit" id="submitBtn" class="btn-submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 12 5 5L20 7"></path>
                        </svg>
                        <span>Submit Admission</span>
                    </button>
                    <button type="button" id="resetBtn" class="btn-reset" title="Reset all fields">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                            <path d="M3 3v5h5"></path>
                        </svg>
                        <span>Reset</span>
                    </button>
                </div>

                <button type="button" id="demoBtn" class="btn-demo">Auto-Fill Demo Profile</button>
            </form>
        </div>

        <!-- Live Event Stream Log -->
        <div class="event-ticker">
            <span>Last Dispatched Event:</span>
            <span id="lastEventLog" class="log-badge">DOMContentLoaded</span>
        </div>
    </div>

    <!-- Confirmation Modal Pass -->
    <div id="modalPass" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
            </div>
            <h2 class="modal-title">Admission Approved</h2>
            <p class="modal-subtitle">Welcome to VALENCE Fitness. Your membership pass is active.</p>

            <div class="membership-pass">
                <div class="pass-row">
                    <span class="pass-label">Pass ID</span>
                    <span id="passId" class="pass-val highlight">VLC-9821</span>
                </div>
                <div class="pass-row">
                    <span class="pass-label">Member Name</span>
                    <span id="passName" class="pass-val">-</span>
                </div>
                <div class="pass-row">
                    <span class="pass-label">Email</span>
                    <span id="passEmail" class="pass-val">-</span>
                </div>
                <div class="pass-row">
                    <span class="pass-label">Mobile</span>
                    <span id="passMobile" class="pass-val">-</span>
                </div>
                <div class="pass-row">
                    <span class="pass-label">Tier & Fee</span>
                    <span id="passTier" class="pass-val highlight">-</span>
                </div>
            </div>

            <button type="button" id="closeModalBtn" class="btn-modal-close">Close & View Pass</button>
        </div>
    </div>

    <script>
        // DOM Element References
        const form = document.getElementById("gymForm");
        const nameInput = document.getElementById("fullName");
        const emailInput = document.getElementById("email");
        const mobileInput = document.getElementById("mobile");
        const ageInput = document.getElementById("age");
        const planSelect = document.getElementById("planSelect");
        const planCards = document.querySelectorAll(".plan-card");

        // Error & Indicator Elements
        const nameError = document.getElementById("nameError");
        const emailError = document.getElementById("emailError");
        const mobileError = document.getElementById("mobileError");
        const ageError = document.getElementById("ageError");
        const planError = document.getElementById("planError");

        const nameIndicator = document.getElementById("nameIndicator");
        const emailIndicator = document.getElementById("emailIndicator");
        const mobileIndicator = document.getElementById("mobileIndicator");
        const ageIndicator = document.getElementById("ageIndicator");
        const planIndicator = document.getElementById("planIndicator");

        const progressFill = document.getElementById("progressFill");
        const progressText = document.getElementById("progressText");
        const lastEventLog = document.getElementById("lastEventLog");

        // Modal Elements
        const modalPass = document.getElementById("modalPass");
        const closeModalBtn = document.getElementById("closeModalBtn");
        const passName = document.getElementById("passName");
        const passEmail = document.getElementById("passEmail");
        const passMobile = document.getElementById("passMobile");
        const passTier = document.getElementById("passTier");
        const passId = document.getElementById("passId");

        const resetBtn = document.getElementById("resetBtn");
        const demoBtn = document.getElementById("demoBtn");

        const PLAN_DETAILS = {
            basic: { name: "Basic", duration: "1 Month", price: "₹1,499" },
            pro: { name: "Pro Athlete", duration: "6 Months", price: "₹6,999" },
            elite: { name: "Elite VIP", duration: "1 Year", price: "₹11,999" }
        };

        function logEvent(name, detail) {
            lastEventLog.innerText = name + (detail ? " (" + detail + ")" : "");
        }

        // 1. Validation Logic
        function validateName() {
            const val = nameInput.value.trim();
            if (val.length === 0) {
                clearState(nameInput, nameError, nameIndicator);
                return false;
            }
            if (val.length >= 3) {
                setValid(nameInput, nameError, nameIndicator);
                return true;
            } else {
                setInvalid(nameInput, nameError, nameIndicator, "Full name must be at least 3 characters.");
                return false;
            }
        }

        function validateEmail() {
            const val = emailInput.value.trim();
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (val.length === 0) {
                clearState(emailInput, emailError, emailIndicator);
                return false;
            }
            if (emailPattern.test(val)) {
                setValid(emailInput, emailError, emailIndicator);
                return true;
            } else {
                setInvalid(emailInput, emailError, emailIndicator, "Please enter a valid email address.");
                return false;
            }
        }

        function validateMobile() {
            mobileInput.value = mobileInput.value.replace(/\D/g, '');
            const val = mobileInput.value;
            if (val.length === 0) {
                clearState(mobileInput, mobileError, mobileIndicator);
                return false;
            }
            if (val.length === 10) {
                setValid(mobileInput, mobileError, mobileIndicator);
                return true;
            } else {
                setInvalid(mobileInput, mobileError, mobileIndicator, "Mobile number must be 10 digits (" + val.length + "/10).");
                return false;
            }
        }

        function validateAge() {
            const val = ageInput.value;
            if (val === "") {
                clearState(ageInput, ageError, ageIndicator);
                return false;
            }
            const num = parseInt(val, 10);
            if (!isNaN(num) && num >= 16 && num <= 100) {
                setValid(ageInput, ageError, ageIndicator);
                return true;
            } else {
                setInvalid(ageInput, ageError, ageIndicator, "You must be 16 or older to join.");
                return false;
            }
        }

        // UI Helper Functions
        function setValid(input, errorEl, indicatorEl) {
            input.classList.add("is-valid");
            input.classList.remove("is-invalid");
            if (errorEl) errorEl.classList.remove("visible");
            if (indicatorEl) indicatorEl.className = "field-indicator active valid";
            updateProgress();
        }

        function setInvalid(input, errorEl, indicatorEl, msg) {
            input.classList.remove("is-valid");
            input.classList.add("is-invalid");
            if (errorEl) {
                const msgSpan = errorEl.querySelector("span");
                if (msgSpan && msg) msgSpan.textContent = msg;
                errorEl.classList.add("visible");
            }
            if (indicatorEl) indicatorEl.className = "field-indicator active invalid";
            updateProgress();
        }

        function clearState(input, errorEl, indicatorEl) {
            input.classList.remove("is-valid", "is-invalid");
            if (errorEl) errorEl.classList.remove("visible");
            if (indicatorEl) indicatorEl.className = "field-indicator";
            updateProgress();
        }

        function updateProgress() {
            let completed = 0;
            if (nameInput.classList.contains("is-valid")) completed++;
            if (emailInput.classList.contains("is-valid")) completed++;
            if (mobileInput.classList.contains("is-valid")) completed++;
            if (ageInput.classList.contains("is-valid")) completed++;
            if (planSelect.value !== "") completed++;

            progressText.textContent = `${completed}/5 Complete`;
            progressFill.style.width = `${(completed / 5) * 100}%`;
        }

        function validatePlan(showError = false) {
            const val = planSelect.value;
            if (val !== "") {
                planError.classList.remove("visible");
                planIndicator.className = "field-indicator active valid";
                updateProgress();
                return true;
            } else {
                if (showError) {
                    planError.classList.add("visible");
                    planIndicator.className = "field-indicator active invalid";
                } else {
                    planError.classList.remove("visible");
                    planIndicator.className = "field-indicator";
                }
                updateProgress();
                return false;
            }
        }

        // Plan Cards Click and Keydown Handling
        planCards.forEach(card => {
            function handleSelect() {
                planCards.forEach(c => c.classList.remove("selected"));
                card.classList.add("selected");
                const planValue = card.getAttribute("data-plan");
                planSelect.value = planValue;
                validatePlan(false);
                logEvent("Plan Selected", PLAN_DETAILS[planValue] ? PLAN_DETAILS[planValue].name : planValue);
            }

            card.addEventListener("click", handleSelect);

            card.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    handleSelect();
                }
            });
        });

        // Real-time Event Listeners
        nameInput.addEventListener("input", () => {
            validateName();
            logEvent("input", `fullName: "${nameInput.value}"`);
        });
        nameInput.addEventListener("blur", validateName);

        emailInput.addEventListener("input", () => {
            validateEmail();
            logEvent("input", `email: "${emailInput.value}"`);
        });
        emailInput.addEventListener("blur", validateEmail);

        mobileInput.addEventListener("input", () => {
            validateMobile();
            logEvent("input", `mobile: "${mobileInput.value}"`);
        });
        mobileInput.addEventListener("blur", validateMobile);

        ageInput.addEventListener("input", () => {
            validateAge();
            logEvent("input", `age: "${ageInput.value}"`);
        });
        ageInput.addEventListener("blur", validateAge);

        planSelect.addEventListener("change", () => {
            const selectedVal = planSelect.value;
            planCards.forEach(card => {
                if (card.getAttribute("data-plan") === selectedVal) {
                    card.classList.add("selected");
                } else {
                    card.classList.remove("selected");
                }
            });
            validatePlan(true);
            logEvent("change", `planSelect: "${selectedVal}"`);
        });

        // Form Submission
        form.addEventListener("submit", (e) => {
            e.preventDefault();

            const isNameValid = validateName();
            const isEmailValid = validateEmail();
            const isMobileValid = validateMobile();
            const isAgeValid = validateAge();
            const isPlanValid = validatePlan(true);

            // Trigger error state visually if submitted with empty fields
            if (!isNameValid && nameInput.value.trim().length === 0) {
                setInvalid(nameInput, nameError, nameIndicator, "Full name must be at least 3 characters.");
            }
            if (!isEmailValid && emailInput.value.trim().length === 0) {
                setInvalid(emailInput, emailError, emailIndicator, "Please enter a valid email address.");
            }
            if (!isMobileValid && mobileInput.value.trim().length === 0) {
                setInvalid(mobileInput, mobileError, mobileIndicator, "Mobile number must be 10 digits.");
            }
            if (!isAgeValid && ageInput.value.trim().length === 0) {
                setInvalid(ageInput, ageError, ageIndicator, "16+ required.");
            }

            if (isNameValid && isEmailValid && isMobileValid && isAgeValid && isPlanValid) {
                const generatedId = "VLC-" + Math.floor(1000 + Math.random() * 9000);
                passId.textContent = generatedId;
                passName.textContent = nameInput.value.trim();
                passEmail.textContent = emailInput.value.trim();
                passMobile.textContent = mobileInput.value.trim();

                const planObj = PLAN_DETAILS[planSelect.value];
                passTier.textContent = planObj ? `${planObj.name} (${planObj.price})` : planSelect.value;

                modalPass.classList.add("open");
                logEvent("submit", `Pass Generated #${generatedId}`);
            } else {
                logEvent("submit", "Validation Failed");
                const firstInvalid = form.querySelector(".is-invalid");
                if (firstInvalid) firstInvalid.focus();
            }
        });

        // Reset Form Action
        resetBtn.addEventListener("click", () => {
            form.reset();
            planCards.forEach(c => c.classList.remove("selected"));
            planSelect.value = "";
            clearState(nameInput, nameError, nameIndicator);
            clearState(emailInput, emailError, emailIndicator);
            clearState(mobileInput, mobileError, mobileIndicator);
            clearState(ageInput, ageError, ageIndicator);
            clearState(planSelect, planError, planIndicator);
            updateProgress();
            logEvent("reset", "Form Cleared");
        });

        // Demo Auto-fill Action
        demoBtn.addEventListener("click", () => {
            nameInput.value = "Rahul Sharma";
            emailInput.value = "rahul.sharma@example.com";
            mobileInput.value = "9876543210";
            ageInput.value = "24";

            const proCard = document.querySelector('.plan-card[data-plan="pro"]');
            if (proCard) {
                proCard.click();
            } else {
                planSelect.value = "pro";
                validatePlan(true);
            }

            validateName();
            validateEmail();
            validateMobile();
            validateAge();
            updateProgress();
            logEvent("demo", "Loaded Demo Profile");
        });

        // Modal Action
        closeModalBtn.addEventListener("click", () => {
            modalPass.classList.remove("open");
            logEvent("click", "Pass Modal Closed");
        });

        modalPass.addEventListener("click", (e) => {
            if (e.target === modalPass) {
                modalPass.classList.remove("open");
                logEvent("click", "Backdrop Modal Closed");
            }
        });

        // Initialize state
        updateProgress();
        logEvent("DOMContentLoaded", "Form Initialized");
    </script>
</body>

</html>
